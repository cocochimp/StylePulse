<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.stylepulse</groupId>
        <artifactId>stylepulse</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>stylepulse-adaptor</artifactId>
    <name>stylepulse-adaptor</name>
    <description>适配器层：input（Controller/MQ 消费者/定时任务）+ output（工厂接口防腐）。只做协议转换</description>

    <dependencies>
        <dependency>
            <groupId>com.stylepulse</groupId>
            <artifactId>stylepulse-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stylepulse</groupId>
            <artifactId>stylepulse-model</artifactId>
        </dependency>
        <!-- 依赖 client 只为拿接口与 DTO；不依赖 application，保证入口与实现解耦 -->
        <dependency>
            <groupId>com.stylepulse</groupId>
            <artifactId>stylepulse-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stylepulse</groupId>
            <artifactId>stylepulse-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>
</project>