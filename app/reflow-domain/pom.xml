<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.reflow</groupId>
        <artifactId>reflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>reflow-domain</artifactId>
    <name>reflow-domain</name>
    <description>领域层：聚合根/实体/值对象/Param/Result/DomainService/Repository 接口。零技术依赖</description>

    <dependencies>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-model</artifactId>
        </dependency>
        <!-- 仅允许 @Service 这类容器注解；Redis / MyBatis / 位图库一律不得出现在本模块 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- 日志门面：领域层可以记日志，但不能绑死 logback/log4j 实现 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>