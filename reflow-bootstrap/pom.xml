<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.reflow</groupId>
        <artifactId>reflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>reflow-bootstrap</artifactId>
    <name>reflow-bootstrap</name>
    <description>装配层：唯一的启动模块，负责组件扫描、数据源、H2/Redis 配置与集成测试</description>

    <dependencies>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reflow</groupId>
            <artifactId>reflow-adaptor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>