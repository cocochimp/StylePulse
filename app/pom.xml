<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.reflow</groupId>
        <artifactId>reflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app</artifactId>
    <packaging>pom</packaging>

    <name>app</name>
    <description>应用核心：DDD 四层（domain / application / infrastructure / adaptor）集中在此目录</description>

    <!--
        为什么四层要收在 app/ 下：这四层是"同一个可部署应用"的内部结构，
        它们之间用 Maven 依赖互相约束；而 common / model / client / bootstrap
        是应用之外的东西（技术基座、对外契约、装配入口），所以留在第一层与 app 平级。

        这样目录结构本身就在回答"哪些代码属于业务内核、哪些是外围设施"。
    -->
    <modules>
        <module>reflow-domain</module>
        <module>reflow-application</module>
        <module>reflow-infrastructure</module>
        <module>reflow-adaptor</module>
    </modules>
</project>